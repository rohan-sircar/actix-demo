#this is required for diesel_cli to work
DATABASE_URL=postgres://postgres:postgres@localhost:5432/actix_demo
ACTIX_DEMO_CORS_ORIGINS=http://localhost:8082
ACTIX_DEMO_DATABASE_URL  = ${DATABASE_URL}
ACTIX_DEMO_FRONTEND_URL         = http://localhost:8082
ACTIX_DEMO_OAUTH_BASE_URL       = http://localhost:8800
ACTIX_DEMO_OAUTH_GOOGLE_BASE_URL = https://oauth2.googleapis.com

ACTIX_DEMO_LOKI_URL      = http://localhost:3100
ACTIX_DEMO_RUST_LOG      = aws=info,hyper=info,debug,diesel_tracing::pg=off
ACTIX_DEMO_TEST_RUST_LOG = aws=info,hyper=info,diesel_tracing::pg=off,debug
ACTIX_DEMO_HTTP_HOST     = 0.0.0.0
ACTIX_DEMO_HTTP_PORT     = 8800
ACTIX_DEMO_HASH_COST     = 8
ACTIX_DEMO_LOGGER_FORMAT = pretty
ACTIX_DEMO_JWT_KEY       = test-jwt-secret-key-at-least-12-bytes
ACTIX_DEMO_REDIS_URL     = redis://127.0.0.1
ACTIX_DEMO_JOB_BIN_PATH  = /bin/echo
ACTIX_DEMO_RATE_LIMIT_AUTH_MAX_REQUESTS       = 10
ACTIX_DEMO_RATE_LIMIT_AUTH_WINDOW_SECS        = 120
ACTIX_DEMO_RATE_LIMIT_API_MAX_REQUESTS        = 500
ACTIX_DEMO_RATE_LIMIT_API_WINDOW_SECS         = 60
ACTIX_DEMO_RATE_LIMIT_DISABLE                 = false
ACTIX_DEMO_RATE_LIMIT_API_PUBLIC_MAX_REQUESTS = 500
ACTIX_DEMO_RATE_LIMIT_API_PUBLIC_WINDOW_SECS  = 60
ACTIX_DEMO_SESSION_EXPIRATION_SECS            = 86400
ACTIX_DEMO_SESSION_CLEANUP_INTERVAL_SECS      = 600
ACTIX_DEMO_MAX_CONCURRENT_SESSIONS            = 10
ACTIX_DEMO_SESSION_RENEWAL_ENABLED            = true
ACTIX_DEMO_SESSION_RENEWAL_WINDOW_SECS        = 1800
ACTIX_DEMO_SESSION_MAX_RENEWALS               = 3
ACTIX_DEMO_SESSION_DISABLE                    = false
ACTIX_DEMO_WORKER_INITIAL_INTERVAL_SECS       = 3
ACTIX_DEMO_WORKER_MULTIPLIER                  = 2.0
ACTIX_DEMO_WORKER_MAX_INTERVAL_SECS           = 30
ACTIX_DEMO_WORKER_MAX_ELAPSED_TIME_SECS       = 300
ACTIX_DEMO_WORKER_RUN_INTERVAL_SECS           = 10
ACTIX_DEMO_HEALTH_CHECK_TIMEOUT_SECS          = 10
ACTIX_DEMO_PROMETHEUS_URL                     = http://localhost:9090
ACTIX_DEMO_MINIO_ENDPOINT                     = http://localhost:9000
ACTIX_DEMO_MINIO_ACCESS_KEY                   = minio
ACTIX_DEMO_MINIO_SECRET_KEY                   = miniominio
ACTIX_DEMO_MINIO_SECURE                       = false
ACTIX_DEMO_MINIO_BUCKET_NAME                  = actix-demo
ACTIX_DEMO_MAX_AVATAR_SIZE                    = 2097152
ACTIX_DEMO_TIMEZONE                           = UTC

# SMTP Configuration
ACTIX_DEMO_SMTP_HOST                          = localhost
ACTIX_DEMO_SMTP_PORT                          = 1025
ACTIX_DEMO_SMTP_TLS_MODE                      = none
ACTIX_DEMO_SMTP_USERNAME                      =
ACTIX_DEMO_SMTP_PASSWORD                      =
ACTIX_DEMO_SMTP_FROM_EMAIL                    = noreply@actix-demo.local

ACTIX_DEMO_SWAGGER_PATH                       = /swagger
